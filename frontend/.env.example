# EduVNU Frontend — Environment Variables
# Sao chép file này thành .env và điền giá trị thực tế

# URL gốc của Backend API (không có dấu / ở cuối)
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Google OAuth Client ID (dùng cho nút "Đăng nhập với Google")
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
